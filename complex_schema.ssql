CREATE TABLE employees (
    id INT,
    first_name STRING,
    last_name STRING,
    email STRING,
    phone_number STRING,
    hire_date STRING,
    job_id STRING,
    salary FLOAT,
    commission_pct FLOAT,
    manager_id INT,
    department_id INT
);

CREATE TABLE departments (
    department_id INT,
    department_name STRING,
    manager_id INT,
    location_id INT
);

CREATE TABLE locations (
    location_id INT,
    street_address STRING,
    postal_code STRING,
    city STRING,
    state_province STRING,
    country_id STRING
);

CREATE TABLE jobs (
    job_id STRING,
    job_title STRING,
    min_salary FLOAT,
    max_salary FLOAT
);

CREATE TABLE job_history (
    employee_id INT,
    start_date STRING,
    end_date STRING,
    job_id STRING,
    department_id INT
);

CREATE TABLE countries (
    country_id STRING,
    country_name STRING,
    region_id INT
);

CREATE TABLE regions (
    region_id INT,
    region_name STRING
);
